# Line endings: text is stored and checked out with LF everywhere. The policy
# sources, scripts and golden files are consumed byte for byte (the test suite
# compares recorded output literally), so CRLF must never appear.

* text=auto eol=lf

# Compiled SELinux policies are binary data: no diff, merge or line ending
# conversion.
*.pol binary
*.pp binary

# Generated data: the compiled fixtures and the recorded golden output are
# reproduced byte for byte by testdata/gen.sh and testdata/gen_expected.sh, so
# code hosting should collapse them and drop them from the language statistics.
testdata/policies/*.pol   linguist-generated=true
policy/testdata/*.pol     linguist-generated=true
testdata/expected/*.txt   linguist-generated=true
testdata/expected_tools/*.txt linguist-generated=true

# Scripts have to keep LF endings to stay executable, and a Makefile with CRLF
# is not a valid makefile.
*.sh     text eol=lf
*.go     text eol=lf
go.mod   text eol=lf
Makefile text eol=lf
